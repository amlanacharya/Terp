{
  "name": "travelerp-lite",
  "private": true,
  "version": "1.0.0",
  "description": "TravelERP Lite - Desktop ERP for Travel Agencies",
  "author": {
    "name": "Intelligrip",
    "email": "info@intelligrup.com"
  },
  "main": "dist/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:frontend": "vite build",
    "build:backend": "cd server && npm run build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:all": "npm run build:frontend && npm run build:backend && npm run build:electron",
    "download:postgres": "node scripts/download-postgres.js",
    "electron:dev": "npm run build:electron && electron .",
    "electron:build": "electron-builder",
    "electron:build:win": "npm run build:all && electron-builder --win",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:electron": "tsc --noEmit -p electron/tsconfig.json"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-reload": "^1.5.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
